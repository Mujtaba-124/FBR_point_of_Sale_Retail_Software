# Copy to .env and set real values. Never commit .env.
# Host ports are offset (5433/6380) to avoid clashing with local PostgreSQL/Redis.

COMPOSE_PROJECT_NAME=cheena_pos

POSTGRES_DB=cheena_database
POSTGRES_USER=cheena_user
POSTGRES_PASSWORD=change_me

POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
BACKEND_INTERNAL_URL=http://backend:8000

# Local development runs on plain HTTP, so cookies cannot be Secure.
# Production MUST leave this true (the backend refuses to start otherwise).
COOKIE_SECURE=false
# true only when the backend is reachable solely through a trusted proxy
# (here: the Next.js /api/v1 proxy). Leave false if the API is exposed directly.
TRUST_PROXY_HEADERS=true

# --- Email settings ---------------------------------------------------------
# Key that encrypts the stored SMTP password (AES-256-GCM). Required to save an
# SMTP password. Generate once per environment and keep it in your secret store,
# backed up SEPARATELY from database backups (a lost key means re-entering the
# SMTP password; a leaked key plus a DB copy exposes it):
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Never commit the real value. Do not change it casually: to rotate, move the
# old key into EMAIL_SETTINGS_PREVIOUS_KEYS, set a new key, then re-save the
# SMTP password in Email Settings.
EMAIL_SETTINGS_ENCRYPTION_KEY=
# Comma-separated old keys, used for decryption only during rotation.
EMAIL_SETTINGS_PREVIOUS_KEYS=
# Development/testing only: allow SMTP hosts on private networks. The backend
# refuses to start in production with this enabled.
SMTP_ALLOW_PRIVATE_HOSTS=false
# smtp (real delivery) | sink (development/QA: write .eml files to EMAIL_SINK_DIR,
# never sent). The backend refuses "sink" in production.
EMAIL_TRANSPORT=smtp
EMAIL_SINK_DIR=/tmp/cheena_email_sink

# --- Shop FBR tokens ---------------------------------------------------------
# Separate AES-256-GCM key for shop FBR integration tokens. Must differ from
# EMAIL_SETTINGS_ENCRYPTION_KEY. Generate it like the email key, keep it in your
# secret store and back it up separately from the database. To rotate: move the
# old key into FBR_TOKEN_PREVIOUS_KEYS, set a new key, re-save each shop token.
FBR_TOKEN_ENCRYPTION_KEY=
FBR_TOKEN_PREVIOUS_KEYS=
